<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- EXCLUDE ENCRYPTED FILES FROM BACKUP (API < 31) -->
    <!-- Auto Backup does not back up hardware-backed Keystore keys. -->
    <!-- Restoring these encrypted files without the keys causes irrecoverable crashes/data loss. -->
    
    <!-- EncryptedSharedPreferences -->
    <exclude domain="sharedpref" path="maswe0002_secure_prefs.xml"/>
    <exclude domain="sharedpref" path="maswe0002_tink_keyset.xml"/>
    
    <!-- Room / SQLCipher Database -->
    <exclude domain="database" path="maswe0002_secure.db"/>
    <exclude domain="database" path="maswe0002_secure.db-wal"/>
    <exclude domain="database" path="maswe0002_secure.db-shm"/>
    
    <!-- Encrypted DataStore / Files -->
    <exclude domain="file" path="datastore/maswe0002_secure.json"/>
    <exclude domain="file" path="maswe0002_safe_internal.json"/>
</full-backup-content>