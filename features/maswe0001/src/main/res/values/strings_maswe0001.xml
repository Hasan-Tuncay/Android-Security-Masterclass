    <string name="maswe_0001_desc">These vectors demonstrate writing data to unprotected private storage locations as per the new MASWE-0001 guidelines.</string>

    <string name="maswe_0001_id">MASWE-0001</string>

    <string name="maswe_0001_msg_1_secure">Encrypted DataStore used (Tink). No plaintext on disk.</string>
    <string name="maswe_0001_msg_1_vuln">Written to DataStore unencrypted (Binary ≠ Encrypted!).</string>
    
    <string name="maswe_0001_msg_2_secure">Encryption key securely generated in Android Keystore.</string>
    <string name="maswe_0001_msg_2_vuln">Data encrypted but key is hardcoded in the source code!</string>

    <string name="maswe_0001_msg_3_secure">Envelope encryption used. DEK wrapped by KEK in Keystore.</string>
    <string name="maswe_0001_msg_3_vuln">Data encrypted but key is stored plainly in SharedPreferences!</string>

    <string name="maswe_0001_msg_4_secure">Strong encryption (AES/GCM/NoPadding) used.</string>
    <string name="maswe_0001_msg_4_vuln">Insufficient encryption (AES/ECB/PKCS5Padding) used!</string>

    <string name="maswe_0001_msg_5_secure">Proper Access Restrictions. Scoped FileProvider used.</string>
    <string name="maswe_0001_msg_5_vuln">Insufficient Access Restrictions. Root-Path FileProvider used!</string>

    <string name="maswe_0001_msg_6_secure">Data securely removed from Cache after use.</string>
    <string name="maswe_0001_msg_6_vuln">Data left in Cache directory indefinitely.</string>

